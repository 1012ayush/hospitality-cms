# Workspace-aware production Dockerfile pattern. Build with --build-arg SERVICE_PKG=@hcm/normalizer.
# OUT OF SCOPE (Part 2B): concrete per-service runtime code and hardened production image policy.
FROM node:20-alpine AS base
ENV PNPM_HOME="/pnpm" PATH="$PNPM_HOME:$PATH"
RUN corepack enable
WORKDIR /repo

FROM base AS pruner
ARG SERVICE_PKG
COPY . .
RUN pnpm dlx turbo prune --scope=${SERVICE_PKG} --docker

FROM base AS installer
COPY --from=pruner /repo/out/json/ ./
RUN pnpm install --no-frozen-lockfile
COPY --from=pruner /repo/out/full/ ./
RUN pnpm turbo run build --filter=${SERVICE_PKG}...

FROM node:20-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app
ARG SERVICE_DIR
COPY --from=installer /repo/ ./
WORKDIR /app/${SERVICE_DIR}
USER node
CMD ["node", "dist/index.js"]
