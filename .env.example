# Local development only. Replace local credentials and require TLS in deployed environments.
# Local compose uses its development migrator login; production uses separate hcm_app / hcm_worker member principals.
DATABASE_URL=postgres://hcm_migrator:local_only_change_me@localhost:5432/hcm?sslmode=disable
WORKER_DATABASE_URL=postgres://hcm_migrator:local_only_change_me@localhost:5432/hcm?sslmode=disable
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Local-only gateway simulator values; HMAC input is unix-seconds + "." + exact raw request bytes.
DEV_WEBHOOK_HMAC_SECRET=local_only_change_me
DEV_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
DEV_CONNECTION_ID=00000000-0000-4000-8000-000000000002
DEV_PROPERTY_ID=00000000-0000-4000-8000-000000000003
WEBHOOK_MAX_BODY_BYTES=1048576
WEBHOOK_REPLAY_WINDOW_SECONDS=300

# Next.js dev/test dashboard. Auth bypass is accepted only outside production.
DASHBOARD_AUTH_DISABLED=true
DASHBOARD_AUTH_PASSWORD=change_this_local_password
DASHBOARD_SIMULATOR_ENABLED=false
DASHBOARD_GATEWAY_URL=http://localhost:8080
DASHBOARD_SIMULATOR_HMAC_SECRET=local_only_change_me
DASHBOARD_API_BASE_URL=
DASHBOARD_API_TOKEN=
DASHBOARD_INVARIANT_API_URL=

# k6 load testing (use isolated non-production property/connection)
GATEWAY_URL=http://localhost:8080
WEBHOOK_HMAC_SECRET=local_only_change_me
PROPERTY_ID=00000000-0000-4000-8000-000000000003
CHANNEL_CONNECTION_ID=00000000-0000-4000-8000-000000000002
ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
ROOM_TYPE_ID=10000000-0000-4000-8000-000000000001
PROPERTY_TIMEZONE=Asia/Kolkata
PROPAGATION_OBSERVER_URL=
PROPAGATION_OBSERVER_TOKEN=
